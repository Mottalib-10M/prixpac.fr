---
/**
 * Accueil d'une langue (page pilier, RECETTE §5). La question d'abord : combien me coûtera une pompe à
 * chaleur, aides déduites, et combien elle me fera gagner. Donc le simulateur en tête, juste sous un
 * bandeau sur le projet de budget 2027 (MaPrimeRénov' PAC menacée), puis trois chiffres clés, la phrase
 * « fait mieux », le bloc citable replié et le texte. Texte dans src/content/accueil.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PacTool from './pac/PacTool';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/accueil';
import { route, type Locale } from '../i18n/routes';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import * as M from '../lib/engine/index';
import type { SourceKey } from '../lib/engine/params';
import { AUTHOR_NAME, LAST_UPDATED } from '../data/site-config';
import { displayDate, formatMoney, formatNumber } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const path = route('home', lang);
const parts = x.body(H).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['spMpr', 'decret2020', 'bar171', 'coupDePouce', 'emmy', 'plf2027', 'meteo', 'ademe', 'observatoire', 'cre', 'eurostatGaz', 'wob'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const fr = lang === 'fr';
const tag = fr ? 'fr-FR' : 'en-GB';
const ex = M.simuler(M.DEFAUT);
const eur = (n: number) => formatMoney(n, 0, lang);
const c100 = M.cee({ type: 'air_eau', logement: 'maison', surface: 100, zone: 'H2', etasHaut: false, coupDePouce: true, couleur: 'violet' });
const plf = route('maprimerenov-pompe-a-chaleur', lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-3">
    <h1 style="hyphens: manual" class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 max-sm:text-[0.95rem] sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil><PacTool client:load lang={lang} id="accueil" methodHref={route('method', lang)} /></div>
  <aside class="mt-4 rounded-lg border-l-4 border-amber-500 bg-amber-50 px-4 py-3 text-sm text-navy-800">
    <strong>{fr ? 'À venir, non voté :' : 'Coming, not yet voted:'}</strong> {fr
      ? <>le projet de budget 2027 prévoit que les pompes à chaleur soient « uniquement financées par les certificats d’économie d’énergie », donc sans MaPrimeRénov’. Le barème 2026 ci-dessus reste celui qui s’applique aux dossiers déposés en 2026. <a class="underline" href={plf}>Ce que cela changerait</a>.</>
      : <>the 2027 draft budget plans for heat pumps to be “funded only by energy-savings certificates”, i.e. without MaPrimeRénov’. The 2026 scale above is the one that applies to applications filed in 2026. <a class="underline" href={plf}>What it would change</a>.</>}
  </aside>
  <div class="mt-6 grid gap-3 sm:grid-cols-3">
    <div class="rounded-lg border border-navy-200 p-4"><p class="text-sm text-navy-600">{fr ? 'Climat le plus doux' : 'Mildest climate'}</p><p class="tabular-nums text-2xl font-bold text-navy-900">{formatNumber(M.parDju()[0].dju, 0, lang)} DJU</p><p class="text-sm text-navy-700">{M.parDju()[0].nom} ({M.parDju()[0].station})</p></div>
    <div class="rounded-lg border border-navy-200 p-4"><p class="text-sm text-navy-600">{fr ? 'Climat le plus froid' : 'Coldest climate'}</p><p class="tabular-nums text-2xl font-bold text-navy-900">{formatNumber(M.parDju().at(-1)!.dju, 0, lang)} DJU</p><p class="text-sm text-navy-700">{M.parDju().at(-1)!.nom} ({M.parDju().at(-1)!.station})</p></div>
    <div class="rounded-lg border border-navy-200 p-4"><p class="text-sm text-navy-600">{fr ? 'Prime CEE Coup de pouce, maison 100 m² (H2)' : 'CEE Coup de pouce bonus, 100 m² house (H2)'}</p><p class="tabular-nums text-2xl font-bold text-navy-900">{eur(c100.eur)}</p><p class="text-sm text-navy-700">{fr ? `${formatNumber(c100.kwhc, 0, lang)} kWh cumac au prix Emmy` : `${formatNumber(c100.kwhc, 0, lang)} kWh cumac at the Emmy price`}</p></div>
  </div>
  <section class="mt-6 rounded-lg bg-accent-50 px-4 py-3 text-navy-800">
    <p><strong>{fr ? 'Ce site' : 'This site'}</strong> {fr
      ? 'chiffre en une minute, sans coordonnées, le prix, MaPrimeRénov’ 2026, la prime CEE en kWh cumac officiels, le reste à charge et l’économie annuelle d’une pompe à chaleur avec le climat réel de votre département (DJU Météo-France).'
      : 'works out in a minute, with no contact details, the price, the 2026 MaPrimeRénov’ grant, the CEE bonus in official kWh cumac, the out-of-pocket cost and the yearly saving of a heat pump with your département’s real climate (Météo-France degree days).'}</p>
  </section>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={2} class="mt-5" />
  <p class="mt-3 text-sm text-navy-600">{fr ? 'Par' : 'By'} <a href={route('about', lang)} class="underline">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline">{fr ? 'Méthode et sources' : 'Method and sources'}</a> · {fr ? 'données relues le' : 'data reread on'} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, tag)}</time> · {fr ? `exemple par défaut : ${eur(ex.resteACharge)} de reste à charge` : `default example: ${eur(ex.resteACharge)} out of pocket`}</p>
  <div class="prose prose-slate mt-8 max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div class="mini-bloc"><MiniSim client:load kind={p} lang={lang} /></div>)}
  </div>
</PageLayout>
