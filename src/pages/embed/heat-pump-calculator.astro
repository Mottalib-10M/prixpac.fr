---
/** Page embarquable (iframe) : le simulateur sans navigation. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import PacTool from '../../components/pac/PacTool';
import { SITE_URL, LAST_UPDATED } from '../../data/site-config';
import { displayDate } from '../../lib/format';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Heat pump calculator for France: price, grants and savings – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <PacTool client:load lang="en" id="embed" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">Prix PAC</a> · 2026 scales, data reread on {displayDate(LAST_UPDATED, 'en-GB')}</p>
  </body>
</html>
