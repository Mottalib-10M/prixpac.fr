---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/heat-pump-calculator/" title="Heat pump calculator for France: price, grants and savings" width="100%" height="1200" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the French heat pump calculator on your website" description="Embed the French heat pump calculator in an iframe for free: price, MaPrimeRénov’, CEE bonus and savings by département, with no sign-up and no cookie on your site." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up, no fee. Expat associations, energy advice centres and local newsrooms set it up in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the tool stays visible, the tool is not altered, and it comes with no warranty. Scales and prices are updated on this site, so your page benefits without you doing anything. French version: <code>{`${SITE_URL}/embed/simulateur-pompe-a-chaleur/`}</code>.</p>
    <p>The income and floor areas your visitors type stay in their browser: nothing goes through our servers, and the embedded frame sets no cookie on your site. For any request, use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/heat-pump-calculator/" title="Heat pump calculator for France: price, grants and savings" width="100%" height="1200" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
